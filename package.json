{
  "name": "soundcontrol",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Desktop companion for Anker Soundcore earbuds and headphones — Web Bluetooth, Web Serial, and RFCOMM bridge.",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "electron": "electron electron-main.cjs",
    "build:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder",
    "bridge": "python3 soundcore_bridge.py",
    "fetch:python-embed": "node scripts/fetch-python-embed.mjs",
    "prebuild:win": "npm run fetch:python-embed"
  },
  "build": {
    "appId": "com.soundcontrol.desktop",
    "productName": "SoundControl",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "soundcore_bridge.py",
      "public/**/*"
    ],
    "asarUnpack": [
      "soundcore_bridge.py"
    ],
    "extraResources": [
      {
        "from": "python-embed",
        "to": "python"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundControl"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/outfit": "^5.2.6",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
