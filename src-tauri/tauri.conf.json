{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundControl",
  "version": "2.0.0",
  "identifier": "com.soundcontrol.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundControl",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://github.com https://api.github.com; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "licenseFile": "LICENSE",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "bluez", "dbus"],
        "section": "utils"
      }
    }
  },
  "plugins": {
    "store": {
      "path": "settings.dat"
    },
    "updater": {
      "endpoints": [
        "https://github.com/Shankers8811/soundcontrol/releases/latest/download/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    },
    "notification": {},
    "globalShortcut": {
      "shortcuts": ["Ctrl+Alt+A", "Ctrl+Alt+G", "Ctrl+Alt+S"]
    }
  }
}