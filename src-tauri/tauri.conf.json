{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundControl",
  "version": "0.1.0",
  "identifier": "com.shankers8811.soundcontrol",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SoundControl",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Native desktop companion for Anker/Soundcore devices. ANC, EQ, battery monitoring, diagnostics.",
    "shortDescription": "SoundControl - Anker/Soundcore Desktop Companion",
    "copyright": "Copyright (c) 2026 Shankers8811",
    "linux": {
      "deb": { "depends": ["libgtk-3-0", "libbluetooth3", "libdbus-1-3"] }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}